@page "/login"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using TaskManager.Application.Contracts
@using TaskManager.BlazorApp.Components.Pages.Auth
@inject HttpClient Http
@inject NavigationManager NavigationManager

<MudGrid Justify="Justify.Center" Class="mt-16">
    <MudItem xs="12" sm="8" md="4">
        <MudCard>
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Login</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudTextField @bind-Value="Username" Label="Username" Variant="Variant.Outlined" Class="mb-4" />
                <MudTextField @bind-Value="Password" Label="Password" InputType="InputType.Password" Variant="Variant.Outlined" Class="mb-4" />
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="HandleLogin">Login</MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>
</MudGrid>

@using System.Net.Http.Json
@using TaskManager.Shared.Requests

@code {
    private string Username { get; set; } = string.Empty;
    private string Password { get; set; } = string.Empty;

    private async Task HandleLogin()
    {
        var request = new LoginRequest { Username = Username, Password = Password };
        var response = await Http.PostAsJsonAsync("/api/auth/login", request);

        if (response.IsSuccessStatusCode)
        {
            NavigationManager.NavigateTo("/", forceLoad: true);
        }
    }
}
